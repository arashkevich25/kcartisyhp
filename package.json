{
  "name": "rep-counter",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "web", "e2e"],
  "scripts": {
    "start": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "test": "npm test --workspaces --if-present --workspace=shared --workspace=server --workspace=web",
    "test:e2e": "npm test -w e2e",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
